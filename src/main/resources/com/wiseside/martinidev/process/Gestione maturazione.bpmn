      <bpmn2:script><![CDATA[ciclo = kcontext.getVariable("idCiclo");
cont=["__piano_veterinario", "__inventario"];
kcontext.setVariable("controlli", cont);
System.out.println("Ho settato i controlli da attivare per il ciclo: "+idCiclo);
]]></bpmn2:script>
    </bpmn2:scriptTask>
