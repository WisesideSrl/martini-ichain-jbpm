      <bpmn2:outgoing>_E8100EF2-12B1-4B49-9E0F-92B2F3976961</bpmn2:outgoing>
      <bpmn2:script><![CDATA[kcontext.setVariable("config", [
  "ts": System.currentTimeMillis(),
  "files_conf" : [
    "ftp_folder": "/Da_SAP/fornitori",
    "template_file": "*.csv",
    "backup_folder": "/Da_SAP/pianificazioni/Elaborati",
    "error_folder": "/Da_SAP/pianificazioni/Error"
  ],
  "error_conf": [
    "send_to": [
      "roberto.bisignano@wiseside.com",
      "cristiano.panzeri@wiseside.com"
    ]
  ]
]);
]]></bpmn2:script>
    </bpmn2:scriptTask>
