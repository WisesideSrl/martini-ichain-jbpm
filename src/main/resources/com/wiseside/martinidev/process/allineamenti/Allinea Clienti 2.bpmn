    <bpmn2:task id="_1825DFA3-C48F-429E-88F9-7FF9F54BF783" drools:taskName="Email" name="Invia email di errore">
      <bpmn2:documentation id="_JbRfKDNkEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-email/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Invia email di errore]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[esit = kcontext.getVariable("esito");
conf = kcontext.getVariable("config");

dest = String.join(",",conf.error_conf.send_to);
sub = "Errore importazione fornitori";
b = esit.log;

kcontext.setVariable("from", "ichain@wiseside.com");
kcontext.setVariable("to", dest);
kcontext.setVariable("subject", sub);
kcontext.setVariable("cc", "roberto.bisignano@wiseside.com");
kcontext.setVariable("body", b);]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
