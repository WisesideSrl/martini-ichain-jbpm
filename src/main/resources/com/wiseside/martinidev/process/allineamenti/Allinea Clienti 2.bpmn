    <bpmn2:task id="_9CAB1E9B-5EDC-490A-A40B-29F4D3DC5015" drools:taskName="Rest" name="Allinea fornitori">
      <bpmn2:documentation id="_JbRfBDNkEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Allinea fornitori]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff=kcontext.getVariable("bff_api_url");
task="importa-fornitori-da-sap/";
version ="v1";

kcontext.setVariable("restUrl", bff+task+version);
cf = kcontext.getVariable("config");
kcontext.setVariable("payload", ["config": cf]);
System.out.println("Allinea fornitori - On Entry");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Allinea fornitori - On Exit");
resp = kcontext.getVariable("response");
System.out.println(resp);
esit= resp.esito;
kcontext.setVariable("esito", esit);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
