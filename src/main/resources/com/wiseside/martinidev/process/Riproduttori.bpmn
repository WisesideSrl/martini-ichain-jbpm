    <bpmn2:task id="_44EA0F47-6F57-4E91-B043-A96E06D98A33" drools:taskName="Rest" name="Creazione ciclo allevamento in stato &quot;Pianificato&quot;">
      <bpmn2:documentation id="_3SJHuh1wEfGMB_KbjiPQGw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Creazione ciclo allevamento in stato "Pianificato"]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff=kcontext.getVariable("bff_api_url");
task = "salva-ciclo-riproduttori-pianificato/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);

cAll = kcontext.getVariable("cicloAllevamento");
kcontext.setVariable("payload", ["cicloAllevamento": cAll]);

System.out.println("Salva ciclo riproduttori pianificato - OnEntry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva ciclo riproduttori pianificato - OnExit");

resp = kcontext.getVariable("response");
cAll = resp.cicloAllevamento;
kcontext.setVariable("idCiclo", cAll.idCiclo);

System.out.println("Ho settato idCiclo a :"+ cAll.idCiclo);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
