    <bpmn2:scriptTask id="_6CB1F2D0-DA15-49BB-AEDF-32CB3936BE7F" name="Calcolo data attivazione" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Calcolo data attivazione]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_CBF15410-556C-4567-9E02-63D11C313C29</bpmn2:incoming>
      <bpmn2:outgoing>_CDE2E089-29E3-4AC9-8B07-8DF54E2100FF</bpmn2:outgoing>
      <bpmn2:script><![CDATA[java.util.Map<String,Object> ca = (java.util.Map<String,Object>) kcontext.getVariable("cicloAllevamento");
Integer delta= (Integer) kcontext.getVariable("deltaAttivazione");

System.out.println("Classe cicloAllevamento.dataImmissione: "+ ca.get("dataImmissione").getClass() );
System.out.println("Valore cicloAllevamento.dataImmissione: "+ca.get("dataImmissione"));
java.time.format.DateTimeFormatter formatter = java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy");
java.time.LocalDateTime dAttivazione = java.time.LocalDate.parse((String)ca.get("dataImmissione"), formatter).atStartOfDay();
//dAttivazione = dAttivazione.plusDays(delta).atZone(ZoneId.of("Europe/Rome"));
System.out.println("Valore dataAttivazione: "+ dAttivazione.minusDays(delta).atZone(java.time.ZoneId.of("Europe/Rome")));
kcontext.setVariable("dataAttivazione", dAttivazione.minusDays(delta).atZone(java.time.ZoneId.of("Europe/Rome")));]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_5CA4F44A-958B-4D4E-A74F-2FB121C474A8" drools:taskName="Rest" name="Stato ciclo In Preparazione">
      <bpmn2:documentation id="_H1RoiUJIEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Stato ciclo In Preparazione]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[ciclo=kcontext.getVariable("idCiclo");
bff=kcontext.getVariable("bff_api_url");
task = "cambio-stato-ciclo/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);
kcontext.setVariable("payload",["idCiclo":ciclo,"stato":"IN_PREPARAZIONE"]);
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
