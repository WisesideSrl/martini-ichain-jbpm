      <bpmn2:startEvent id="_7A6304BF-F342-41E4-8220-33A6C18B121D" name="Avvia controllo">
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Avvia controllo]]></drools:metaValue>
          </drools:metaData>
        </bpmn2:extensionElements>
