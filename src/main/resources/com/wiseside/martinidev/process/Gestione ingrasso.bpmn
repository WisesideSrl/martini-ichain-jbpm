      </bpmn2:startEvent>
      <bpmn2:task id="_9FE0E20C-A566-4C78-9AE5-1920068C3B9E" drools:taskName="Rest" name="Avvio controllo">
        <bpmn2:documentation id="_IBfHHUIdEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Avvio controllo]]></drools:metaValue>
          </drools:metaData>
          <drools:metaData name="customAsync">
            <drools:metaValue><![CDATA[true]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="avvia-controllo/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
contr = kcontext.getVariable("controllo");
System.out.println("Prima di chiamare il servizio rest, stampo idCiclo:"+ciclo);
kcontext.setVariable("iPayload", ["idCiclo": ciclo, "controllo": contr]);
]]></drools:script>
          </drools:onEntry-script>
          <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[resp = kcontext.getVariable("iResponse");
cLanciato = resp.controlloLanciato;
kcontext.setVariable("controlloLanciato", cLanciato);
System.out.println("Controllo "+cLanciato+" avviato correttamente");
