    <bpmn2:task id="_76F8C7D8-F2CD-427A-8D05-0C3DF3B79A5D" drools:taskName="Rest" name="Attiva conferimenti a macello">
      <bpmn2:documentation id="_cfrFco9YEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Attiva conferimenti a macello]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff=kcontext.getVariable("bff_api_url");
task = "attiva-conferimenti-macello/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);

idC = kcontext.getVariable("idCiclo");
rVivo = kcontext.getVariable("ritiriVivo");
//TEST
System.out.println("RITIRI_VIVO = " + rVivo);

kcontext.setVariable("payload",["idCiclo":idC, "ritiriVivo": rVivo]);
//kcontext.setVariable("idCiclo", idC);
//kcontext.setVariable("ritiriVivo", rVivo);
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
