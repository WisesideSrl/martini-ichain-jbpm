    <bpmn2:task id="_3101BBCF-29E1-4F6A-ACC6-947FDB598AA8" drools:taskName="Rest" name="Crea nuovo ciclo in stato Pianificato">
      <bpmn2:documentation id="_cfrFs49YEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Crea nuovo ciclo in stato Pianificato]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff=kcontext.getVariable("bff_api_url");
task="salva-ciclo-ingrasso-pianificato/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);
cicloAll = kcontext.getVariable("cicloAllevamento");
kcontext.setVariable("payload", ["cicloAllevamento": cicloAll]);
System.out.println(task +" - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("salva-ciclo-ingrasso-pianificato - On Exit");

resp = kcontext.getVariable("response");
cicloAll = resp.cicloAllevamento;

kcontext.setVariable("cicloAllevamento", cicloAll);
kcontext.setVariable("idCiclo", cicloAll.idCiclo);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
