    <bpmn2:task id="_93E5EA50-AA6C-41DD-8B8D-A1ECA07313C8" drools:taskName="Rest" name="Salva ricevimento">
      <bpmn2:documentation id="_mxzhYiL8EfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva ricevimento]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task = "salva-ricevimento-riproduttori/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
dRic = kcontext.getVariable("datiRicevimento");
utente = kcontext.getVariable("username");

kcontext.setVariable("payload", ["idCiclo": ciclo, "datiRicevimento": dRic, "username": utente]);
System.out.println("salva-ricevimento-riproduttori - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("salva-ricevimento-riproduttori - On Exit");

resp = kcontext.getVariable("response");

kcontext.setVariable("datiRicevimento", resp.datiRicevimento);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
