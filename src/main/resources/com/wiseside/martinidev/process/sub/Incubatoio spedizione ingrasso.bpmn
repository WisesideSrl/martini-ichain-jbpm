    <bpmn2:task id="_CF152E2B-A46A-4449-91C8-968BBB3C4832" drools:taskName="Rest" name="Salva invio ingrasso">
      <bpmn2:documentation id="_POJNBE4GEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva invio ingrasso]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff=kcontext.getVariable("bff_api_url");
task="salva-spedizione-incubatoio/";
version ="v2";

kcontext.setVariable("restUrl", bff+task+version);

idInc = kcontext.getVariable("idIncubatoio");
dSped = kcontext.getVariable("datiSpedizione");
utente = kcontext.getVariable("username");
kcontext.setVariable("payload", ["idIncubatoio": idInc, "datiSpedizione": dSped, "username": utente]);
System.out.println("salva-spedizione-incubatoio  - On Entry");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("salva-spedizione-incubatoio  - On Entry");

resp = kcontext.getVariable("response");

dSped = resp.datiSpedizione;
kcontext.setVariable("datiSpedizione", dSped)]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
