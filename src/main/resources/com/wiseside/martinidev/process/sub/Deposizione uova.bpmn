    <bpmn2:task id="_1686FD78-D49A-4578-86BD-8AA9919600C3" drools:taskName="Rest" name="Salvataggio deposizione uova">
      <bpmn2:documentation id="_tur8s01NEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salvataggio deposizione uova]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="salva-deposizione-uova/";
version="v1";

kcontext.setVariable("restUrl", bff+task+version);

System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
utente = kcontext.getVariable("username");
dUova = kcontext.getVariable("deposizioneUova");
gg = kcontext.getVariable("giorno");

kcontext.setVariable("payload", ["idCiclo": ciclo, "username": utente, "deposizioneUova": dUova, "giorno": gg]);
System.out.println("Salva deposizione uova - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva deposizione uova - On Exit");
resp = kcontext.getVariable("response");

kcontext.setVariable("giorno", resp.giorno);
kcontext.setVariable("dataDeposizione", resp.dataMortalita);
kcontext.setVariable("deposizioneUova", new java.util.HashMap());
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
