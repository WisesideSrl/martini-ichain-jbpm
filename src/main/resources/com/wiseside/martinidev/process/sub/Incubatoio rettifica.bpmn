    <bpmn2:task id="_5E61A6B9-1B3B-4760-AD05-D727C6000629" drools:taskName="Rest" name="Inizializza rettifica incubatoio">
      <bpmn2:documentation id="_XyTnKaxuEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza rettifica incubatoio]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task = "inizializza-rettifica-incubatoio/";
version = "v1";

kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version);

incubatoio = kcontext.getVariable("idIncubatoio");
kcontext.setVariable("payload", ["idIncubatoio": idIncubatoio]);

System.out.println("Inizializza rettifica incubatoio - On Entry");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza rettifica incubatoio - On Exit");
resp = kcontext.getVariable("response");]]></drools:script>
        </drools:onExit-script>
