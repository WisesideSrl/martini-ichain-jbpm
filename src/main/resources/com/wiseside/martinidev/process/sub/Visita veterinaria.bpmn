    <bpmn2:task id="_65934A22-596D-4B80-B393-01143BB6F699" drools:taskName="Rest" name="Salva visita veterinaria">
      <bpmn2:documentation id="_MiPfshh4EfGMB_KbjiPQGw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva visita veterinaria]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="salva-visita-veterinaria/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
vVet = kcontext.getVariable("visitaVeterinaria");
utente = kcontext.getVariable("username");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "visitaVeterinaria": vVet, "username": utente]);
System.out.println("Salva visita veterinaria - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva visita veterinaria - On Exit");
resp = kcontext.getVariable("response");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
