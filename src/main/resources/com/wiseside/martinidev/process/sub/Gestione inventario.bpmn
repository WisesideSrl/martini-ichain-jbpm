      <bpmn2:task id="_51C7A77F-AA0F-4567-A326-E558D9E1FE51" drools:taskName="Rest" name="Calcola prossima attivazione">
        <bpmn2:documentation id="_QG2t2kPZEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Calcola prossima attivazione]]></drools:metaValue>
          </drools:metaData>
          <drools:metaData name="customAsync">
            <drools:metaValue><![CDATA[true]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[bff=kcontext.getVariable("bff_api_url");
task="prossimo-trimestre/";
version ="v1";

kcontext.setVariable("restUrl", bff+task+version);

ciclo = kcontext.getVariable("idCiclo");
dInv = kcontext.getVariable("datiInventario");

kcontext.setVariable("payload", ["idCiclo": ciclo, "datiInventario": dInv]);
System.out.println("prossimo-trimestre  - On Entry");
]]></drools:script>
          </drools:onEntry-script>
          <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[System.out.println("prossimo-trimestre  - On Exit");

resp = kcontext.getVariable("response");

dInv = resp.datiInventario;

kcontext.setVariable("datiInventario", dInv);
]]></drools:script>
          </drools:onExit-script>
        </bpmn2:extensionElements>
