          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="salva-inventario/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);

ciclo = kcontext.getVariable("idCiclo");
dTrim = kcontext.getVariable("dataTrimestre");
stocks = kcontext.getVariable("feedStocks");
utente = kcontext.getVariable("username");
kcontext.setVariable("payload", ["idCiclo": ciclo, "dataTrimestre": dTrim, "feedStocks": stocks, "username": utente]);
System.out.println("Salva inventario - On Entry");]]></drools:script>
