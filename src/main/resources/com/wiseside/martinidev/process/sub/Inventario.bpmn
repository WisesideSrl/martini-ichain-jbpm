    <bpmn2:task id="_7EA8352F-AE15-42B7-AC95-2E0F591BFC78" drools:taskName="Rest" name="Salva inventario">
      <bpmn2:documentation id="_iiCfL07KEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
