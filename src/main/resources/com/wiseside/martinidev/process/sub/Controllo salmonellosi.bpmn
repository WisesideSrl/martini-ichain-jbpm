    <bpmn2:task id="_C4C2920F-AC71-4C0A-BA85-F10F43B24739" drools:taskName="Rest" name="Invio SISALM">
      <bpmn2:documentation id="_nt7LWxCnEfGMB_KbjiPQGw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Invio SISALM]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="invio-sisalm/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

cSalm = kcontext.getVariable("controlloSalmonellosi");

kcontext.setVariable("payload", ["controlloSalmonellosi": cSalm]);
System.out.println("Invio SISALM - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Invio SISALM - On Exit");

resp = kcontext.getVariable("response");

cSalm = kcontext.getVariable("controlloSalmonellosi");

kcontext.setVariable("controlloSalmonellosi", cSalm);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
