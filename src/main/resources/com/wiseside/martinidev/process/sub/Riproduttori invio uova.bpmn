    <bpmn2:task id="_B34D14BB-05F9-4041-BB99-70FF5079EE7B" drools:taskName="Rest" name="Inizializza spedizione uova incubatoio">
      <bpmn2:documentation id="__aW2R2lyEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza spedizione uova incubatoio]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task="inizializza-spedizione-uova-verso-incubatoio/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
System.out.println("Questo è il ciclo riproduttori "+ ciclo);

//username = kcontext.getVariable("username");

//System.out.println("Questo è il responsabile ciclo riproduttori "+ username);

ordineUova = kcontext.getVariable("ordineUova");

//kcontext.setVariable("payload", ["idCiclo": ciclo]);
kcontext.setVariable("payload", ["idCiclo": ciclo, "ordineUova": ordineUova]);
System.out.println("Inizializza spedizione uova a incubatoio - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza spedizione uova a incubatoio - On Exit");
resp = kcontext.getVariable("response");

kcontext.setVariable("ordineUova", resp.ordineUova);
kcontext.setVariable("tecnicoResponsabile", resp.tecnicoResponsabile);
kcontext.setVariable("username", resp.tecnicoResponsabile);
kcontext.setVariable("idCiclo", resp.idCiclo);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
