    <bpmn2:task id="_A4D96E38-BDCB-4CFC-81A3-696F27CDBEC5" drools:taskName="Rest" name="Salva dati spedizione uova a incubatoio">
      <bpmn2:documentation id="_rnaXBmWmEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva dati spedizione uova a incubatoio]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task="salva-dati-spedizione-uova-incubatoio/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
ordineUova = kcontext.getVariable("ordineUova");

utente = kcontext.getVariable("username");

//kcontext.setVariable("payload", ["idIncubatoio": incubatoio, "username": utente, "ordineUova": ordineUova]);
kcontext.setVariable("payload", ["idCiclo": ciclo, "username": utente, "ordineUova": ordineUova]);
System.out.println("Salva richiesta spedizione uova - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva dati spedizione uova a incubatoio - On Exit");
resp = kcontext.getVariable("response");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
