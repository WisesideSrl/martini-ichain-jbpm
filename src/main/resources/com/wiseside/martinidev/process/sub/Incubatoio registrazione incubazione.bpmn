    <bpmn2:task id="_0DDAAC3E-94BB-493B-B0DA-6A6731CF61B9" drools:taskName="Rest" name="Salva registrazione incubazione">
      <bpmn2:documentation id="_c47FYYc8EfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva registrazione incubazione]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task="salva-registrazione-incubazione/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

incubatoio = kcontext.getVariable("idIncubatoio");
utente = kcontext.getVariable("username");
warehouseStock = kcontext.getVariable("warehouseStock");
lottiDaIncubare = kcontext.getVariable("lottiDaIncubare");

kcontext.setVariable("payload", ["idIncubatoio": incubatoio, "username": utente, "warehouseStock" : warehouseStock, "lottiDaIncubare" : lottiDaIncubare]);
System.out.println("Salva richiesta spedizione uova - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva registrazione incubazione - On Exit");
resp = kcontext.getVariable("response");]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
