    <bpmn2:task id="_D2C54AA0-9FEB-4583-857B-BE1162E4CFE1" drools:taskName="Rest" name="Salva chiusura straordinaria">
      <bpmn2:documentation id="_C-vzdiFXEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva chiusura straordinaria]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="salva-chiusura-straordinaria/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
utente = kcontext.getVariable("username");
dChius = kcontext.getVariable("datiChiusuraStraordinaria");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "username": utente, "datiChiusuraStraordinaria": dChius]);
System.out.println("Salva chiusura straordinaria - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva chiusura straordinaria - On Exit");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
