    <bpmn2:task id="_D2C54AA0-9FEB-4583-857B-BE1162E4CFE1" drools:taskName="Rest" name="Salva chiusura straordinaria">
      <bpmn2:documentation id="_n3S6YiFVEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
