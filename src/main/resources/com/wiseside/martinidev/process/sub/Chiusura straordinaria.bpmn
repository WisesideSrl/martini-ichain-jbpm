bff = kcontext.getVariable("bff_api_url");
task="salva-chiusura-straordinaria/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
utente = kcontext.getVariable("username");
dChius = kcontext.getVariable("datiChiusuraStraordinaria");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "username": utente, "datiChiusuraStraordinaria": dChius]);
System.out.println("Salva chiusura straordinaria - On Entry");]]></drools:script>
