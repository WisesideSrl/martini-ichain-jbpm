    <bpmn2:task id="_421B3BB3-D207-4845-B8B4-EEAC11FC5E72" drools:taskName="Rest" name="Salva mortalità">
      <bpmn2:documentation id="_jgmfgwNIEfGwDt7WaqQKVg"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva mortalità]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="salva-mortalita/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);

ciclo = kcontext.getVariable("idCiclo");
mort = kcontext.getVariable("mortalita");
g = kcontext.getVariable("giorno");
kcontext.setVariable(payload, ["idCiclo": ciclo, "mortalita": mort, "giorno": g]);
System.out.println("Salva mortalita - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva mortalita - On Exit");
resp = kcontext.getVariable("response");

kcontext.setVariable("giorno", resp.giorno);
kcontext.setVariable("dataMortalita", resp.dataMortalita);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
