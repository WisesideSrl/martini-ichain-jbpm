    <bpmn2:task id="_9ED5E1DA-9B71-40E1-A549-F54813CCE1CA" drools:taskName="Rest" name="Inizializza mortalità">
      <bpmn2:documentation id="_jgmftwNIEfGwDt7WaqQKVg"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza mortalità]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="inizializza-mortalita/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
System.out.println("Questo è il payload "+ ["idCiclo": ciclo]);
System.out.println("Inizializza mortalita - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza mortalita - On Exit");
resp=kcontext.getVariable("response");

kcontext.setVariable("datiCiclo", resp.datiCiclo);
kcontext.setVariable("giorno", resp.giorno);
kcontext.setVariable("tecnicoResponsabile", resp.tecnicoReponsabile);
kcontext.setVariable("dataMortalita", resp.dataMortalita);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_89FB8B2F-ABFD-43B3-9D66-2E0B7335F18A</bpmn2:incoming>
      <bpmn2:outgoing>_4F6ABE7B-8743-41BE-A838-2B354CFC53FF</bpmn2:outgoing>
