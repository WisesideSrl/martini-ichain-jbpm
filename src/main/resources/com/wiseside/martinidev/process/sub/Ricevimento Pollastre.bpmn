    <bpmn2:scriptTask id="_2B4F0ABD-CEA3-4B03-96FD-1089033E0167" name="Dati accasamento pollastre BDN" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Dati accasamento pollastre BDN]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_9CE8F6FE-2A81-4842-B735-91FF275B8384</bpmn2:incoming>
      <bpmn2:outgoing>_C0342670-4708-429A-A452-CD9C08D938E3</bpmn2:outgoing>
      <bpmn2:script><![CDATA[
java.util.Map dPartita = (java.util.Map)kcontext.getVariable("datiPartita");
java.util.Map oPollastre = (java.util.Map)kcontext.getVariable("ordinePollastre");
java.util.List ripartizioniList = (java.util.List)kcontext.getVariable("ripartizioni");

java.util.Map ripPerCap = new java.util.HashMap();
System.out.println("prima del for");
ripartizioniList.forEach( ripObj-> {
  System.out.println("dentro il for");
  java.util.Map rip = (java.util.Map) ripObj;
  int curr = 0;
  if (ripPerCap.containsKey(rip.get("capannone"))){
    java.util.Map singoloCap = (java.util.Map)ripPerCap.get(rip.get("capannone"));
    curr = (Integer) singoloCap.get("numeroAnimali");
  }
  java.util.Map ripCap= new java.util.HashMap();
  ripCap.put("capannone",rip.get("capannone"));
  ripCap.put("numeroAnimali", (Integer)rip.get("numeroPulcini") + curr);
  ripPerCap.put(rip.get("capannone"), ripCap);
});
java.util.List ripList = new java.util.ArrayList(ripPerCap.values());

java.util.Map accBdn = new java.util.HashMap();
accBdn.put("dataOraConsegna", ((java.util.Map) dPartita.get("ddt")).get("dataOraConsegna"));
accBdn.put("motivo", "STATO ESTERO");
accBdn.put("ripartizioni", ripList);

//"specie", oPollastre.get("razza"),
java.util.Map certAcc = new java.util.HashMap();
certAcc.put("codice",((java.util.Map)dPartita.get("certificato")).get("codice"));
certAcc.put("data",((java.util.Map)dPartita.get("certificato")).get("data"));
accBdn.put("certificato", certAcc);

kcontext.setVariable("accasamentoBdn", accBdn);

]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_58016713-0F64-4181-B93D-469BD59223CB" drools:taskName="Rest" name="Invio dati BDN">
      <bpmn2:documentation id="_Z9VDginyEfGcncfWcKxctQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Invio dati BDN]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
kcontext.setVariable("restUrl", bff+"invio-dati-bdn");

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
accBdn = kcontext.getVariable("accasamentoBdn");

kcontext.setVariable("payload", [
    "idCiclo": ciclo,
    "accasamentoBdn": accBdn
]);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[resp = kcontext.getVariable("response");

kcontext.setVariable("accasamentoBdn", resp.accasamentoBdn);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
