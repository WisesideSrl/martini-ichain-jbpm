    <bpmn2:scriptTask id="_8D18F41D-177E-4C3A-AAD7-63ACAB3EDC35" name="Dati magazzino" scriptFormat="http://www.java.com/java">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Dati magazzino]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_18582830-8666-42F1-A571-C22D119BCA23</bpmn2:incoming>
      <bpmn2:outgoing>_399A56B7-ECE6-4C92-86E8-F335C191A1DB</bpmn2:outgoing>
      <bpmn2:script><![CDATA[java.util.List ripList = (java.util.List) kcontext.getVariable("ripartizioni");

java.util.Map<String, Integer> totali =
    ripList.stream()
        .collect(java.util.stream.Collectors.groupingBy(
            m -> (String) ((java.util.Map) m).get("sesso"),
            java.util.stream.Collectors.summingInt( m -> (Integer) ((java.util.Map) m).get("numeroPulcini"))
        ));

java.util.Map ripCap = ripList.stream()
    .collect(java.util.stream.Collectors.groupingBy(
        m -> (String) ((java.util.Map) m).get("capannone"),
        java.util.stream.Collectors.groupingBy(
            m -> (String) ((java.util.Map) m).get("sesso"),
            java.util.stream.Collectors.summingInt(m-> (Integer) ((java.util.Map) m).get("numeroPulcini"))
        )
     ));

java.util.Map mag = new java.util.HashMap();
mag.put("numeroFemmine", totali.get("f"));
mag.put("numeroMaschi", totali.get("m"));
mag.put("numeroTotale", (Integer)totali.get("f") + (Integer)totali.get("m"));
mag.put("suddivisioni", ripCap);
kcontext.setVariable("magazzino", mag);]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:exclusiveGateway id="_D6E8C06B-D06F-45D5-9FA9-E7F9CCCF8948" gatewayDirection="Converging">
      <bpmn2:incoming>_03B1AC0C-6D1D-4CAD-A8DE-2E2076CD0091</bpmn2:incoming>
      <bpmn2:incoming>_F14D9A54-C98F-4F27-AB16-EC77F44869DF</bpmn2:incoming>
