    <bpmn2:task id="_4895809C-A1BE-4CCB-A7C4-7F34E8CB8C0D" drools:taskName="Rest" name="Salva dati ricevimento">
      <bpmn2:documentation id="_K0OQ5F2TEfGOy88veGEEvg"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva dati ricevimento]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task = "salva-ricevimento/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
accBdn = kcontext.getVariable("accasamentoBdn");
dRic = kcontext.getVariable("datiRicevimento");
kcontext.setVariable("payload", [
    "idCiclo": ciclo,
    "accasamentoBdn": accBdn,
    "ripartizioni": dRic.ripartizioni
 ]);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("salva-ricevimento - On Exit");

resp = kcontext.getVariable("response");

accBdn = resp.accasamentoBdn;
mag = resp.magazzino;

kcontext.setVariable("accasamentoBdn", accBdn);
kcontext.setVariable("magazzino", mag);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
