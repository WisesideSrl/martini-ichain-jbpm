    <bpmn2:task id="_8AE5271E-ED2B-412A-BB93-5CAC146BAF70" drools:taskName="Rest" name="Inizializza ricevimento">
      <bpmn2:documentation id="_eAIGK_OkEfC7LbOq7tqkTQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza ricevimento]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
kcontext.setVariable("restUrl", bff+"inizializza-ricevimento");

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
System.out.println("Prima di chiamare il servizio rest, stampo idCiclo:"+ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[resp = kcontext.getVariable("response");

kcontext.setVariable("datiCiclo", resp.datiCiclo);
kcontext.setVariable("ordinePollastre", resp.ordinePollastre);
kcontext.setVariable("datiPartita", resp.datiPartita);
kcontext.setVariable("tecnicoResponsabile", resp.tecnicoResponsabile);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
