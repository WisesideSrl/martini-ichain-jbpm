    <bpmn2:task id="_4895809C-A1BE-4CCB-A7C4-7F34E8CB8C0D" drools:taskName="Rest" name="Salva dati ricevimento">
      <bpmn2:documentation id="_eAIF9POkEfC7LbOq7tqkTQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva dati ricevimento]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "v1";
kcontext.setVariable("restUrl", bff+"salva-ricevimento/"+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
accBdn = kcontext.getVariable("accasamentoBdn");
rips = kcontext.getVariable("ripartizioni");
kcontext.setVariable("payload", [
    "idCiclo": ciclo,
    "accasamentoBdn": accBdn,
    "ripartizioni": rips
 ]);
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
