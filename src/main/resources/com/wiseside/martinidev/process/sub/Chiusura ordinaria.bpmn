    <bpmn2:task id="_64351DCB-8525-40AC-8668-9824E9824E81" drools:taskName="Rest" name="Inizializza chiusura ordinaria">
      <bpmn2:documentation id="_sO7kIM_MEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza chiusura ordinaria]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="inizializza-chiusura-ordinaria/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
System.out.println("Inizializza chiusura ordinaria - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza chiusura ordinaria - On Exit");

resp = kcontext.getVariable("response");

kcontext.setVariable("tecnicoResponsabile", resp.tecnicoResponsabile);
kcontext.setVariable("allevatoreResponsabile", resp.allevatoreResponsabile);
kcontext.setVariable("datiCiclo", resp.datiCiclo);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
