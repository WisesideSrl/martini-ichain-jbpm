    <bpmn2:task id="_5C5C1F9B-99E6-4002-B39A-4286AE21E9B1" drools:taskName="Rest" name="Registrazione BDN trattamento">
      <bpmn2:documentation id="_LWXMC_7kEfClKqlzGC8jgQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Registrazione BDN trattamento]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
task = "registrazione-bdn-trattamento";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
smstr = kcontext.getVariable("somministrazioniConcluse");
trt = kcontext.getVariable("trattamento");
System.out.println("Chiamo servizio rest "+task);
kcontext.setVariable("payload", ["somministrazioni": smstr, "trattamento": trt]);
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
