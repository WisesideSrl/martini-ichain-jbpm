      <bpmn2:task id="_8162D2C2-69A2-4380-9490-C8CC03B85261" drools:taskName="Rest" name="Crea trattamento">
        <bpmn2:documentation id="_QlogdPxjEfCiO5nYug96Yw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Crea trattamento]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
kcontext.setVariable("restUrl", bff+"crea-trattamento"+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
iCiclo = kcontext.getVariable("idCiclo");
System.out.println("Chiamo servizio rest crea-trattamento");
kcontext.setVariable("payload", ["idCiclo": iCiclo]);
]]></drools:script>
          </drools:onEntry-script>
          <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[resp = kcontext.getVariable("response");
t = kcontext.getVariable("trattamento");
if (t==null){
    t= new java.util.HashMap();
    t["stato"]="PROGRAMMATO";
    t["dataAttivazione"] = java.time.Instant.now().toString();
    t["dataPrevistaTrattamento"] = java.time.Instant.now().toString();
    t["daPiano"] = true;
}

t["id"] = resp.idTrattamento;
t["codice"] = resp.codiceTrattamento;

kcontext.setVariable("trattamento", t);
kcontext.setVariable("tecnicoResponsabile", resp.tecnicoResponsabile);
kcontext.setVariable("veterinarioResponsabile", resp.veterinarioResponsabile)]]></drools:script>
          </drools:onExit-script>
        </bpmn2:extensionElements>
