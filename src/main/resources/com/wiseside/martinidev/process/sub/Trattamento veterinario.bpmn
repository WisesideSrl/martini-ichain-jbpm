    <bpmn2:task id="_6E436C42-23AF-4B66-82F3-864D5D67F5AB" drools:taskName="Rest" name="Recupero dati ricetta elettronica BDN">
      <bpmn2:documentation id="_LWXL0v7kEfClKqlzGC8jgQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Recupero dati ricetta elettronica BDN]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
task = "recupera-ricetta-elettronica";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
t = kcontext.getVariable("trattamento");
rifRicetta = kcontext.getVariable("riferimentiRicetta");
vet = kcontext.getVariable("veterinarioResponsabile");
rifRicetta["veterinario"] = vet;
System.out.println("Chiamo servizio rest "+task);
kcontext.setVariable("payload", ["trattamento": t, "riferimentiRicetta": rifRicetta]);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[resp= kcontext.getVariable("response");
trt = kcontext.getVariable("trattamento");
ricet = resp.get("ricetta");
oFarm = resp.get("ordineMedicinali");
statoTrt= resp.get("stato");

trt.stato = statoTrt;
kcontext.setVariable("ricetta", ricet);
kcontext.setVariable("ordineMedicinali", oFarm);
kcontext.setVariable("trattamento", trt);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
