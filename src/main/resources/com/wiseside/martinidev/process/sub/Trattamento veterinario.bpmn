        <bpmn2:documentation id="_1-Ivx_yFEfCiO5nYug96Yw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Aggiorna trattamento veterinario]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
kcontext.setVariable("restUrl", bff+"aggiorna-trattamento-veterinario"+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
t = kcontext.getVariable("trattamento");
System.out.println("Chiamo servizio rest aggiorna-trattamento-veterinario");
kcontext.setVariable("payload", ["trattamento": t]);
]]></drools:script>
          </drools:onEntry-script>
          <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[resp = kcontext.getVariable("response");
kcontext.setVariable("trattamento", resp.trattamento);]]></drools:script>
          </drools:onExit-script>
        </bpmn2:extensionElements>
