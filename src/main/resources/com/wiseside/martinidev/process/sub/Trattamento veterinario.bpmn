      <bpmn2:sequenceFlow id="_898C7EC4-37E0-4705-8E11-E8E0D2923378" name="Si" sourceRef="_CEAD268F-A3FF-43C5-91B6-3E195725A12F" targetRef="_615F037F-2E20-4DDA-BF82-E0676B542F54">
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Si]]></drools:metaValue>
          </drools:metaData>
        </bpmn2:extensionElements>
        <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_JVRNnwRcEfGwDt7WaqQKVg" language="http://www.java.com/java"><![CDATA[java.util.Map<String,Object> smstr = (java.util.Map<String,Object>) kcontext.getVariable("somministrazione");
if (smstr.get("confermaInizio") == null || !((java.lang.Boolean) smstr.get("confermaInizio"))) {
    return false;
}

java.time.format.DateTimeFormatter formatter = java.time.format.DateTimeFormatter.ofPattern("yyyy-MM-dd");
java.time.LocalDateTime dInizio = java.time.LocalDate.parse((String)smstr.get("dataInizio"), formatter).atStartOfDay();
System.out.println("Data inizio trattamento: "+dInizio);

java.time.LocalDateTime dFineCiclo = java.time.LocalDateTime.ofInstant(java.time.Instant.parse((String)smstr.get("dataFineCiclo")),java.time.ZoneId.of("Europe/Rome"));
System.out.println("Data fine ciclo: "+ dFineCiclo);

Integer durata = (Integer) smstr.get("durata");
Integer tSosp = (Integer) smstr.get("tempoSospensione");
java.time.LocalDateTime dFineTratt = dInizio.plusDays(durata+tSosp).atZone(java.time.ZoneId.of("Europe/Rome")).toLocalDateTime();
return dFineTratt.isAfter(dFineCiclo);

]]></bpmn2:conditionExpression>
      </bpmn2:sequenceFlow>
