        <bpmn2:sequenceFlow id="_AFA12753-EED2-473D-A5C0-C591A3052842" name="Si" sourceRef="_96A7D661-474C-4C33-B88A-380F894F1D6D" targetRef="_8885D4E3-CA91-4DB6-B97D-D5ACC83BE03F">
          <bpmn2:extensionElements>
            <drools:metaData name="elementname">
              <drools:metaValue><![CDATA[Si]]></drools:metaValue>
            </drools:metaData>
          </bpmn2:extensionElements>
          <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_8KPmWf1BEfCiO5nYug96Yw" language="http://www.java.com/java"><![CDATA[Map<String,Object> smstr = (Map<String,Object>) kcontext.getVariable("somministrazione");
if (smstr.get("confermaInizio") == null || !((java.util.Boolean) smstr.get("confermaInizio"))) {
    return false;
}
java.time.format.DateTimeFormatter formatter = java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy");
java.time.LocalDateTime dInizio = java.time.LocalDate.parse((String)smstr.get("dataInizio"), formatter).atStartOfDay();
java.time.LocalDateTime dFineCiclo = java.time.LocalDate.parse((String)smstr.get("dataFineCiclo")).atStartOfDay;
Integer durata = (Integer) smstr.get("durata");
Integer tSosp = (Integer) smstr.get("tempoSospensione");
java.time.LocalDateTime dFineTratt = dInizio.plusDays(durata+tSosp).atZone(java.time.ZoneId.of("Europe/Rome"));
return dFineTratt > dFineCiclo;
]]></bpmn2:conditionExpression>
        </bpmn2:sequenceFlow>
        <bpmn2:sequenceFlow id="_37937816-082B-4B72-80A1-C7ED09EF85BC" name="Si" sourceRef="_B2B2EA59-CD9C-48B2-96B5-5B0E9E8E16A8" targetRef="_FB4023DC-54E3-4C6E-B64A-48ACCCCBD14A">
