      <bpmn2:scriptTask id="_15531F69-0F5E-4743-8ADD-53B8720B88C6" name="Programma trattamento" scriptFormat="http://www.java.com/java">
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Programma trattamento]]></drools:metaValue>
          </drools:metaData>
        </bpmn2:extensionElements>
        <bpmn2:incoming>_AC1F8961-C56D-45C2-A534-A1D8A314D3B2</bpmn2:incoming>
        <bpmn2:outgoing>_E66988F3-64A4-48A8-9A5F-F0B1FBED9ADC</bpmn2:outgoing>
        <bpmn2:script><![CDATA[System.out.println("Pianifico il trattamento");
java.util.Map<String,Object> tvp = (java.util.Map<String,Object>) kcontext.getVariable("trattamentoVeterinarioPianificato");
System.out.println("Trattamento x: "+ tvp);

String intervalloStr = (String) tvp.get("intervallo");
String iAttStr = (String) tvp.get("intervalloAttivazione");
System.out.println("intervallo: "+intervalloStr);
System.out.println("intervalloAttivazione: "+ iAttStr);

java.time.temporal.TemporalAmount intervallo = java.time.Duration.parse(intervalloStr);
 
java.time.temporal.TemporalAmount iAtt = java.time.Duration.parse(iAttStr);

java.time.Instant inizioCiclo= java.time.Instant.parse((String) tvp.get("dataInizio"));
 
java.util.Map<String, Object> t = new java.util.HashMap<>();

t.put("idCiclo", tvp.get("idCiclo"));
t.put("durata", tvp.get("durata"));
t.put("descrizione", tvp.get("descrizione"));
t.put("daPiano", true);
t.put("capannoniTrattati", "Tutti");
t.put("stato", "PROGRAMMATO");
t.put("dataPrevistaTrattamento", inizioCiclo.plus(intervallo));
t.put("dataAttivazione",inizioCiclo.plus(intervallo).minus(iAtt));

kcontext.setVariable("trattamento", t);
]]></bpmn2:script>
      </bpmn2:scriptTask>
      <bpmn2:endEvent id="_072437B4-268E-4890-8ACC-2EF91E667528" name="Fine pianificazione trattamento">
