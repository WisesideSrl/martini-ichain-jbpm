      <bpmn2:task id="_E2FD0C65-F1F5-4301-8762-41FA294828B7" drools:taskName="Rest" name="Start Trattamento Veterinario">
        <bpmn2:documentation id="_RbXm6veHEfC7LbOq7tqkTQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Start Trattamento Veterinario]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
kcontext.setVariable("restUrl", bff+"start_trattamento_veterinario"+version);

//Prelevo il trattamento
t = kcontext.getVariable("trattamento");
System.out.println("Prima di chiamare il servizio rest carica-piano-veterinario, stampo trattamento: "+t);
kcontext.setVariable("payload", ["trattamento": t]);
]]></drools:script>
          </drools:onEntry-script>
        </bpmn2:extensionElements>
