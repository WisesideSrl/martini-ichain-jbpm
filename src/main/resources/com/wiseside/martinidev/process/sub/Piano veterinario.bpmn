    <bpmn2:task id="_4BF85E5F-CA5A-44DE-96EF-871932AABEC3" drools:taskName="Rest" name="Carica piano veterinario">
      <bpmn2:documentation id="_RbXmxveHEfC7LbOq7tqkTQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Carica piano veterinario]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
kcontext.setVariable("restUrl", bff+"carica-piano-veterinario"+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
System.out.println("Prima di chiamare il servizio rest carica-piano-veterinario, stampo idCiclo:"+ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[resp = kcontext.getVariable("response");
tvp = resp.get("trattamentiVeterinariPianificati");
kcontext.setVariable("trattamentiVeterinariPianificati", tvp);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
