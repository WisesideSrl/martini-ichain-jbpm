      <bpmn2:task id="_941E7FCE-F57F-4C88-91D1-941A4BC8BDC5" drools:taskName="Rest" name="Start trattamento veterinario">
        <bpmn2:documentation id="_0XFeWP6XEfCiO5nYug96Yw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Start trattamento veterinario]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
kcontext.setVariable("restUrl", bff+"start-trattamento-veterinario"+version);

//Prelevo il trattamento
t = kcontext.getVariable("trattamento");
ciclo = kcontext.getVariable("idCiclo");
System.out.println("Prima di chiamare il servizio rest carica-piano-veterinario, stampo trattamento: "+t);
kcontext.setVariable("payload", ["idCiclo":ciclo, "trattamento": t]);
]]></drools:script>
          </drools:onEntry-script>
        </bpmn2:extensionElements>
