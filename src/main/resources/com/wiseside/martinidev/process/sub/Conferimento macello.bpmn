    <bpmn2:task id="_FB71F352-9C2E-4735-9F9A-3B70F296E80A" drools:taskName="Rest" name="Invio dati BDN">
      <bpmn2:documentation id="_s4lUUM1SEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Invio dati BDN]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="invio-bdn-conferimento-macello/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
datiConf = kcontext.getVariable("datiConferimento")
rip = kcontext.getVariable("ripartizioni");
kcontext.setVariable("payload", ["idCiclo": ciclo, "datiConferimento": datiConf, "ripartizioni": rip]);
System.out.println("Invio bdn conferimento macello - On Entry");

]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Invio bdn conferimento macello - On Exit");

resp = kcontext.getVariable("response");
dConf = resp.datiConferimento;

kcontext.setVariable("datiConferimento", dConf);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
