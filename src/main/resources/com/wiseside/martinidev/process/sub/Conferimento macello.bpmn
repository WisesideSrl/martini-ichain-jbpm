    <bpmn2:task id="_1DF9E848-237E-4799-BDE8-35A6DD53F462" drools:taskName="Rest" name="Inizializza conferimento macello">
      <bpmn2:documentation id="_s4lUMc1SEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza conferimento macello]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task = "inizializza-conferimento-macello/";
version = "v1";

kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version);

ciclo = kcontext.getVariable("idCiclo");
kcontext.setVariable("payload", ["idCiclo": ciclo]);

System.out.println("Inizializza conferimento macello - On Entry");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza conferimento macello - On Exit");
resp = kcontext.getVariable("response");

tResp = resp.tecnicoResponsabile;
aResp = resp.allevatoreResponsabile;
vResp = resp.veterinarioResponsabile;

kcontext.setVariable("tecnicoResponsabile", tResp);
kcontext.setVariable("allevatoreResponsabile", aResp);
kcontext.setVariable("veterinarioResponsabile", vResp);

kcontext.setVariable("datiCiclo", resp.datiCiclo);]]></drools:script>
