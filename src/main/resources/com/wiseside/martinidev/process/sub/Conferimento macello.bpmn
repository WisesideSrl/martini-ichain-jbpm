    <bpmn2:task id="_E4541F43-54B2-492D-A9A9-CCB26CA4A5AD" drools:taskName="Rest" name="Elimina Mod 4">
      <bpmn2:documentation id="__xThoHqvEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Elimina Mod 4]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="elimina-modello4/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

cSalm = kcontext.getVariable("controlloSalmonellosi");
utente = kcontext.getVariable("username");
kcontext.setVariable("payload", ["controlloSalmonellosi": cSalm, "username": utente]);
System.out.println("Salva passaggio calzari - On Entry");]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
