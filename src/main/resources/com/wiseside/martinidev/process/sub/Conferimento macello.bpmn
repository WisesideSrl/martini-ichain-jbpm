          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task="salva-spedizione-conferimento-macello/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
datiConf = kcontext.getVariable("datiConferimento")
ripartizioniSped = kcontext.getVariable("ripartizioniSpedite")

kcontext.setVariable("payload", ["idCiclo": ciclo, "datiConferimento": datiConf, "ripartizioniSpedite": ripartizioniSped]);
System.out.println("Salva spedizione conferimento macello - On Entry");]]></drools:script>
