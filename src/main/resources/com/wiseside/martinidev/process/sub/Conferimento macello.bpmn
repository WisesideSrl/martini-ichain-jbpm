    <bpmn2:task id="_1DF9E848-237E-4799-BDE8-35A6DD53F462" drools:taskName="Rest" name="Inizializza conferimento macello">
      <bpmn2:documentation id="_aXdQwXtgEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza conferimento macello]]></drools:metaValue>
        </drools:metaData>
