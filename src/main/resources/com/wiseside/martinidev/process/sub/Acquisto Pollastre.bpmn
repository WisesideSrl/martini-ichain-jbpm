    <bpmn2:task id="_7A87565F-576F-4492-953D-80EE97882FBC" drools:taskName="Email" name="Send mail AUSL">
      <bpmn2:documentation id="_YS1_zgKKEfGwDt7WaqQKVg"><![CDATA[jbpm-workitems-email/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Send mail AUSL]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.java.com/java">
          <drools:script><![CDATA[java.util.Map<String,Object> emailVar = (java.util.Map<String,Object>)kcontext.getVariable("comunicazioneAusl");
System.out.println("Questa è la comunicazione AUSL " + emailVar);
java.util.List<java.util.Map<String,Object>> destinatari = (java.util.List<java.util.Map<String,Object>>) emailVar.get("destinatari");
System.out.println("Destinatari: "+ destinatari);
java.util.List<String> toList = new java.util.ArrayList<String>();
for (java.util.Map<String,Object> item : destinatari){
    System.out.println(item.get("email"));
    toList.add(item.get("email").toString());
}
String dest = String.join(";",toList);
System.out.println("Lista destinatari in stringa "+ dest);
kcontext.setVariable("emailFrom",emailVar.get("mittente").toString());
System.out.println("Ho settato il mittente");
kcontext.setVariable("emailTo", dest);
System.out.println("Ho settato il destinatario ");
kcontext.setVariable("emailSubject", emailVar.get("oggetto").toString());
System.out.println("Ho settato il subject");
String body="<!DOCTYPE html>" +
    "<html>" +
    "<head>" +
    "  <meta charset=\"UTF-8\">" +
    "</head>" +
    "<body style=\"font-family: Arial, sans-serif; font-size: 14px;\">" +
    "  <div>" +
         (String) emailVar.get("testo") +
    "  </div>" +
    "</body>" +
    "</html>";
kcontext.setVariable("emailBody", body );
System.out.println("Dati passati all'handler per spedire mail");
]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
