          <drools:metaValue><![CDATA[Invio UVAC]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
kcontext.setVariable("restUrl", bff+"invio-dati-uvac");

uvac = kcontext.getVariable("documentoUvac");
ordine = kcontext.getVariable("ordinePollastre");

kcontext.setVariable("payload", ["documentoUvac": uvac, "ordinePollastre": ordinePollastre]);

]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[uvac = kcontext.getVariable("response");

kcontext.setVariable("documentoUvac", uvac);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
