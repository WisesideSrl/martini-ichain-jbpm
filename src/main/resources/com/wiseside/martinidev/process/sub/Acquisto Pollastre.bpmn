    <bpmn2:task id="_E8FA7FA9-B4F5-401E-B456-2B9BD74EAEFB" drools:taskName="Rest" name="Salva dati partita">
      <bpmn2:documentation id="_YS1_bgKKEfGwDt7WaqQKVg"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva dati partita]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
kcontext.setVariable("restUrl", bff+"salva-dati-partita");

dp = kcontext.getVariable("datiPartita");
ordine = kcontext.getVariable("ordinePollastre");

kcontext.setVariable("payload", ["datiPartita": dp, "ordinePollastre": ordinePollastre]);

]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[res= kcontext.getVariable("response");
kcontext.setVariable("datiPartita", res.datiPartita)]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
