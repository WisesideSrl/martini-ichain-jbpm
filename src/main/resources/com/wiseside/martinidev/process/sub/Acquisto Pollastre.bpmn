    <bpmn2:scriptTask id="_A531ABCA-E0C6-4D33-83CE-260C5B61F848" name="Prepara dati UVAC" scriptFormat="http://www.mvel.org/2.0">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Prepara dati UVAC]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_FF52E251-505D-4587-AA6D-4215E9937741</bpmn2:incoming>
      <bpmn2:outgoing>_32C90D55-D808-4918-8906-EACF6FF44BA4</bpmn2:outgoing>
      <bpmn2:script><![CDATA[dp = kcontext.getVariable("datiPartita");
kcontext.setVariable("documentoUvac", [
  "intra": dp.certificato.intra,
  "provenienza": dp.certificato.luogo,
  "dataEmissione": dp.certificato.data
]);
]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:scriptTask id="_19169FCF-4983-4B2E-9EF9-24BF361E860A" name="Genera ordine" scriptFormat="http://www.mvel.org/2.0">
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Genera ordine]]></drools:metaValue>
        </drools:metaData>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_3C095A50-44B0-4ECF-8A59-57217A09D378</bpmn2:incoming>
      <bpmn2:outgoing>_5BD46792-39E1-49E2-A1C4-0B2A10DFD841</bpmn2:outgoing>
      <bpmn2:script><![CDATA[//Qui setto una nuova variabile Ordine basata sulla PropostaOrdine precedente
pop = kcontext.getVariable("propostaOrdinePollastre");

kcontext.setVariable("ordinePollastre", [
  "numeroDocumento": pop.numeroDocumento,
  "allevamento" : pop.allevamento,
  "data": pop.dataDocumento,
  "fornitore": pop.fornitore,
  "settimana": pop.settimana,
  "dataConsegna": pop.dataConsegna,
  "razza": "ross_308",
  "numeroFemmine": pop.numeroFemmine,
  "numeroMaschi": pop.numeroMaschi
]);
]]></bpmn2:script>
    </bpmn2:scriptTask>
    <bpmn2:task id="_3C9C5267-9626-4A55-824E-939DEBDA058A" drools:taskName="Rest" name="Salva autorizzazione">
      <bpmn2:documentation id="_YS1_CgKKEfGwDt7WaqQKVg"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva autorizzazione]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
kcontext.setVariable("restUrl", bff+"salvataggio-proposta-ordine");

ciclo = kcontext.getVariable("idCiclo");
pop = kcontext.getVariable("propostaOrdinePollastre");

System.out.println("Prima di chiamare il servizio rest, stampo idCiclo:"+ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "propostaOrdinePollastre": pop, "operazione":"autorizza"]);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[res = kcontext.getVariable("response");
System.out.println("Risposta servizio Salva proposta ordine pollastre:"+res);

//Aggiorno la mappa proposta ordine di processo
kcontext.setVariable("propostaOrdinePollastre", res.propostaOrdinePollastre);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
