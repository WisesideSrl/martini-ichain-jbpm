    <bpmn2:task id="_FC1E9821-AF11-4AB3-9147-C3854C0D051D" drools:taskName="Rest" name="Preparazione comunicazione AUSL">
      <bpmn2:documentation id="_YS1X5AKKEfGwDt7WaqQKVg"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Preparazione comunicazione AUSL]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
kcontext.setVariable("restUrl", bff+"prepara-comunicazione-ausl");

ciclo = kcontext.getVariable("idCiclo");
ordine = kcontext.getVariable("ordinePollastre");

System.out.println("Prima di chiamare il servizio rest, stampo idCiclo:"+ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "ordinePollastre": ordinePollastre]);

]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[res = kcontext.getVariable("response");
System.out.println("Risposta servizio Preparazione comunicazione AUSL:"+res);

kcontext.setVariable("comunicazioneAusl", res.comunicazioneAusl);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
