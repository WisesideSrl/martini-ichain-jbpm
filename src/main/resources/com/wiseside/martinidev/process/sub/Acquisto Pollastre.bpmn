    <bpmn2:task id="_7D7AA013-E736-46E7-8233-1243BA05FD2F" drools:taskName="Rest" name="Prepara proposta ordine d'acquisto">
      <bpmn2:documentation id="_YS1YXwKKEfGwDt7WaqQKVg"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Prepara proposta ordine d'acquisto]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
kcontext.setVariable("restUrl", bff+"prepara-po-pollastre");

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
System.out.println("Prima di chiamare il servizio rest, stampo idCiclo:"+ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero variabili dal contesto (process data)
res = kcontext.getVariable("response");
System.out.println("Risposta servizio Proposta ordine pollastre:"+res);

//Aggiorno valori variabili di processo con quelli preparati nel service precendente
kcontext.setVariable("datiCiclo", res.datiCiclo);
kcontext.setVariable("propostaOrdinePollastre", res.propostaOrdinePollastre);
kcontext.setVariable("tecnicoResponsabile", res.tecnicoResponsabile);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
