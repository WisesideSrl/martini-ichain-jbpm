    <bpmn2:task id="_284CF1AB-F09D-49FD-8955-9ACC40730FF5" drools:taskName="Rest" name="Prepara dati BDN">
      <bpmn2:documentation id="_JWjfb9kQEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Prepara dati BDN]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="prepara-dati-bdn-trasferimento/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
tAnimali = kcontext.getVariable("trasferimentoAnimali");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "trasferimentoAnimali": tAnimali]);
System.out.println("Prepara dati BDN trasferimento - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Prepara dati BDN trasferimento - On Exit");

resp = kcontext.getVariable("response");
kcontext.setVariable("datiBdn", resp.datiBdn);
kcontext.setVariable("magazzino", resp.magazzino);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
