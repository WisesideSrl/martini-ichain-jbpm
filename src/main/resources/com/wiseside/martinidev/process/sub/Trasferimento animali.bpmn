    <bpmn2:task id="_CF46CB2C-AB04-424A-9B73-B4C9C98621C2" drools:taskName="Rest" name="Salva dati BDN">
      <bpmn2:documentation id="_RhJEZtngEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva dati BDN]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="salva-dati-bdn-trasferimento/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
dBdn = kcontext.getVariable("datiBdn");
trasfAnimali = kcontext.getVariable("trasferimentoAnimali");
utente = kcontext.getVariable("username");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "datiBdn": dBdn, "username": utente, "trasferimentoAnimali": trasfAnimali]);
System.out.println("Salva dati BDN trasferimento - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva dati BDN trasferimento - On Exit");

resp = kcontext.getVariable("response");
kcontext.setVariable("datiBdn", resp.datiBdn);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
