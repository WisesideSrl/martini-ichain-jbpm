    <bpmn2:task id="_30E59B00-6BB9-4586-B39C-9C6122506401" drools:taskName="Rest" name="Inizializza trasferimento animali">
      <bpmn2:documentation id="_hXKec6YDEfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza trasferimento animali]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="inizializza-trasferimento-animali/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
System.out.println("Inizializza trasferimento animali - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza trasferimento animali - On Exit");
resp = kcontext.getVariable("response");
tResp = resp.tecnicoResponsabile;
dCiclo = resp.datiCiclo;

kcontext.setVariable("tecnicoResponsabile", tResp);
kcontext.setVariable("datiCiclo", dCiclo);
kcontext.setVariable("trasferimentoAnimali", resp.trasferimentoAnimali);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
