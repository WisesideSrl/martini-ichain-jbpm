      <bpmn2:documentation id="_g9xNXFm9EfGJ8OMXB3lcuQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza richiesta spedizione uova]]></drools:metaValue>
