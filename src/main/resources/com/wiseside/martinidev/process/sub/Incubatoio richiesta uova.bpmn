    <bpmn2:task id="_4902FBA4-A510-4C9B-98A8-05272E48D778" drools:taskName="Rest" name="Salva richiesta spedizione uova">
      <bpmn2:documentation id="_XdUCYGXbEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva richiesta spedizione uova]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task="salva-richiesta-spedizione-incubatoio/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

incubatoio = kcontext.getVariable("idIncubatoio");
utente = kcontext.getVariable("username");

ordineUova = kcontext.getVariable("ordineUova");
giacenzePerData = kcontext.getVariable("giacenzePerData");

kcontext.setVariable("payload", ["idIncubatoio": incubatoio, "username": utente, "ordineUova": ordineUova, "giacenzePerData": giacenzePerData]);
System.out.println("Salva richiesta spedizione uova - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva richiesta spedizione uova - On Exit");
resp = kcontext.getVariable("response");

kcontext.setVariable("ordineUova", resp.ordineUova);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
