    <bpmn2:task id="_30E59B00-6BB9-4586-B39C-9C6122506401" drools:taskName="Rest" name="Inizializza richiesta spedizione uova">
      <bpmn2:documentation id="_axLVLmmBEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza richiesta spedizione uova]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task="inizializza-richiesta-spedizione-uova/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

incubatoio = kcontext.getVariable("idIncubatoio");
System.out.println("Questo è l'incubatoio "+ incubatoio);

kcontext.setVariable("payload", ["idIncubatoio": incubatoio]);
System.out.println("Inizializza richiesta spedizione uova - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza richiesta spedizione uova - On Exit");
resp = kcontext.getVariable("response");

//kcontext.setVariable("ordineUova", ["codiceTrasferimento": resp.codiceTrasferimentoUova]);
kcontext.setVariable("ordineUova", resp.ordineUova);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
