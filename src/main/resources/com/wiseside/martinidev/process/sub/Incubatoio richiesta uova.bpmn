    <bpmn2:task id="_822DE2FA-A1DD-47E0-BA7F-18C2CB4D01B4" drools:taskName="Rest" name="Salva ricevimento uova">
      <bpmn2:documentation id="_axL8W2mBEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva ricevimento uova]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task="salva-ricevimento-uova/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

incubatoio = kcontext.getVariable("idIncubatoio");
//ordineUova = kcontext.getVariable("ordineUova");
spedizioneUova = kcontext.getVariable("spedizioneUova");
utente = kcontext.getVariable("username");

//kcontext.setVariable("payload", ["idIncubatoio": incubatoio, "username": utente, "ordineUova": ordineUova]);
kcontext.setVariable("payload", ["idIncubatoio": incubatoio, "username": utente, "spedizioneUova": spedizioneUova]);
System.out.println("Salva ricevimento uova - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Salva ricevimento uova - On Exit");
resp = kcontext.getVariable("response");]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
