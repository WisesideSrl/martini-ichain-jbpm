    <bpmn2:task id="_8AE65604-530E-4599-8BEB-81FCF3AC21BA" drools:taskName="Rest" name="Invio BDN">
      <bpmn2:documentation id="_htFZGNVREfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Invio BDN]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task = "invio-bdn-ricevimento-ingrasso-da-fornitori/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
dBdn = kcontext.getVariable("datiBdn");
dRic = kcontext.getVariable("datiRicevimento");
kcontext.setVariable("payload", ["idCiclo": ciclo, "datiBdn": dBdn, "datiRicevimento": dRic]);
System.out.println("salva-ricevimento-ingrasso-da-fornitori - On Entry");]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
