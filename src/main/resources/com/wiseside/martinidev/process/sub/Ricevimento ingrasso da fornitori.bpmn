    <bpmn2:task id="_4F819117-EA91-488A-A1CF-CCE7030817A0" drools:taskName="Rest" name="Inizializza ricevimento ingrasso">
      <bpmn2:documentation id="_htFY9NVREfGo77v80codAw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza ricevimento ingrasso]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task = "inizializza-ricevimento-ingrasso-da-fornitori/";
version = "v1";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
ciclo = kcontext.getVariable("idCiclo");
//dRic = kcontext.getVariable("datiRicevimento");  //NON DISPONIBILE ANCORA, ma nel form successivo si (tramite helper)
//kcontext.setVariable("payload", ["idCiclo": ciclo, "datiRicevimento": dRic]);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
System.out.println("inizializza-ricevimento-ingrasso-da-fornitori - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("inizializza-ricevimento-ingrasso-da-fornitori - On Exit");
resp = kcontext.getVariable("response");

dCiclo = resp.datiCiclo;
tResp = resp.tecnicoResponsabile;
kcontext.setVariable("datiCiclo", dCiclo);
kcontext.setVariable("tecnicoResponsabile", tResp);]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
