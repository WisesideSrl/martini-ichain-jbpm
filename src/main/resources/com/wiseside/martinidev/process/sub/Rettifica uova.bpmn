    <bpmn2:task id="_88530A88-390A-42BC-A369-7357D7EC12D2" drools:taskName="Rest" name="Inizializza rettifica uova">
      <bpmn2:documentation id="_XqMRD2mTEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza rettifica uova]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="inizializza-rettifica-uova/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo]);
System.out.println("Questo è il payload "+ ["idCiclo": ciclo]);
System.out.println("Inizializza rettifica uova - On Entry");]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza rettifica uova - OnExit");
resp = kcontext.getVariable("response");

dCiclo = resp.datiCiclo;
tResponsabile = resp.tecnicoResponsabile;

kcontext.setVariable("datiCiclo", dCiclo);
kcontext.setVariable("tecnicoResponsabile", tResponsabile);
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
      <bpmn2:incoming>_818BEDBC-4529-4534-95A2-6177ADB6227C</bpmn2:incoming>
