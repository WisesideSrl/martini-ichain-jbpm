    <bpmn2:task id="_73AE6E16-1BE9-4FEB-BD69-AA9BE13287D0" drools:taskName="Rest" name="Salva movimento">
      <bpmn2:documentation id="_2OkrEmmREfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Salva movimento]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
task="salva-rettifica-animali/";
version="v1";
kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version)

ciclo = kcontext.getVariable("idCiclo");
user = kcontext.getVariable("username");
rett = kcontext.getVariable("rettifica");
System.out.println("Questo è il ciclo "+ ciclo);
kcontext.setVariable("payload", ["idCiclo": ciclo, "username": user, "rettifica": rett]);
System.out.println("Inizializza rettifica animali - On Entry");]]></drools:script>
        </drools:onEntry-script>
      </bpmn2:extensionElements>
