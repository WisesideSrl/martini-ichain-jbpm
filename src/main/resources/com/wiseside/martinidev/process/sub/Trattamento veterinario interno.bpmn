          <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_AR1Pe_7hEfClKqlzGC8jgQ" language="http://www.mvel.org/2.0"><![CDATA[smstr = kcontext.getVariable("somministrazione");
return smstr.confermaTermine;]]></bpmn2:conditionExpression>
        </bpmn2:sequenceFlow>
