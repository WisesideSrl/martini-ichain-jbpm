              <drools:metaValue><![CDATA[Si]]></drools:metaValue>
            </drools:metaData>
          </bpmn2:extensionElements>
          <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression" id="_47ew_f7ZEfClKqlzGC8jgQ" language="http://www.mvel.org/2.0"><![CDATA[smstr = kcontext.getVariable("somministrazione");
return smstr.confermaTermine;]]></bpmn2:conditionExpression>
        </bpmn2:sequenceFlow>
