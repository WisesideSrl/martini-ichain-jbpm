      <bpmn2:task id="_F9DC558E-95E7-451F-A09D-797C2C632B5B" drools:taskName="Rest" name="Invia ordine a farmacia e amministrazione via mail">
        <bpmn2:documentation id="_AR1OwP7hEfClKqlzGC8jgQ"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
        <bpmn2:extensionElements>
          <drools:metaData name="elementname">
            <drools:metaValue><![CDATA[Invia ordine a farmacia e amministrazione via mail]]></drools:metaValue>
          </drools:metaData>
          <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[//Recupero l'url generale di chiamata (da sovrascrivere ogni volta)
bff = kcontext.getVariable("bff_api_url");
version = "/v1";
task = "invio-ordine-medicinali";
kcontext.setVariable("restUrl", bff+task+version);

//Prelevo l'idCiclo (supponendo a questo punto sia gia salvato)
om = kcontext.getVariable("ordineMedicinali");
om["utente"]= kcontext.getVariable("tecnicoResponsabile");
trt = kcontext.getVariable("trattamento");
System.out.println("Chiamo servizio rest "+task);
kcontext.setVariable("payload", ["ordineMedicinali": om, "trattamento": trt]);
]]></drools:script>
          </drools:onEntry-script>
          <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
            <drools:script><![CDATA[resp = kcontext.getVariable("response");
kcontext.setVariable("somministrazioni", resp.somministrazioni);]]></drools:script>
          </drools:onExit-script>
        </bpmn2:extensionElements>
