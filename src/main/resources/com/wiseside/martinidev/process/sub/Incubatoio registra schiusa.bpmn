    <bpmn2:task id="_1DF9E848-237E-4799-BDE8-35A6DD53F462" drools:taskName="Rest" name="Inizializza registrazione schiusa">
      <bpmn2:documentation id="_2X3awYUUEfG3PfFtblwADw"><![CDATA[jbpm-workitems-rest/index.html]]></bpmn2:documentation>
      <bpmn2:extensionElements>
        <drools:metaData name="elementname">
          <drools:metaValue><![CDATA[Inizializza registrazione schiusa]]></drools:metaValue>
        </drools:metaData>
        <drools:metaData name="customAsync">
          <drools:metaValue><![CDATA[true]]></drools:metaValue>
        </drools:metaData>
        <drools:onEntry-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[bff = kcontext.getVariable("bff_api_url");
task = "inizializza-registrazione-schiusa-uova/";
version = "v1";

kcontext.setVariable("restUrl", bff+task+version);
System.out.println("Questo è l'url "+ bff+task+version);

incubatoio = kcontext.getVariable("idIncubatoio");
kcontext.setVariable("payload", ["idIncubatoio": idIncubatoio]);

System.out.println("Inizializza registrazione schiusa uova - On Entry");
]]></drools:script>
        </drools:onEntry-script>
        <drools:onExit-script scriptFormat="http://www.mvel.org/2.0">
          <drools:script><![CDATA[System.out.println("Inizializza registrazione schiusa uova - On Exit");
resp = kcontext.getVariable("response");
]]></drools:script>
        </drools:onExit-script>
      </bpmn2:extensionElements>
